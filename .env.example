# ================== Core ==================
NODE_ENV=development
TENANT_DEFAULT_ID=00000000-0000-0000-0000-000000000001
TENANT_DEFAULT_NAME="Küchen Klaus"

# ================== API / Web ==================
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PORT=3000
WEB_PUBLIC_URL=http://localhost:3000
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ================== Database ==================
POSTGRES_USER=kkos
POSTGRES_PASSWORD=kkos
POSTGRES_DB=kkos
DATABASE_URL=postgresql://kkos:kkos@localhost:5432/kkos?schema=public

# ================== Redis / Queues ==================
REDIS_URL=redis://localhost:6379

# ================== Object Storage ==================
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET_DOCUMENTS=kkos-documents
S3_BUCKET_AUDIO=kkos-audio
S3_FORCE_PATH_STYLE=true

# ================== Mail ==================
# Local dev uses MailHog SMTP + any imap-simulator
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
# For production IMAP ingest, configure mailboxes in DB
IMAP_DEFAULT_HOST=
IMAP_DEFAULT_PORT=993
IMAP_DEFAULT_TLS=true

# ================== LLM Gateway ==================
LLM_PROVIDER=anthropic   # anthropic | openai | local
LLM_API_KEY=
LLM_MODEL_CLASSIFY=claude-haiku-4-5-20251001
LLM_MODEL_EXTRACT=claude-sonnet-4-6
LLM_REDACT_PII=true

# ================== Speech ==================
SPEECH_STT_BACKEND=faster-whisper   # faster-whisper | whisper-cpp | http
SPEECH_STT_URL=http://localhost:9010
SPEECH_STT_MODEL=large-v3
SPEECH_STT_LANGUAGE=de

SPEECH_TTS_BACKEND=chatterbox        # chatterbox | qwen3 | http
SPEECH_TTS_URL=http://localhost:9020
SPEECH_TTS_VOICE_DEFAULT=de-female-warm

# ================== Feature Flags ==================
FEATURE_VOICE=true
FEATURE_VOICE_CLONE=false
FEATURE_SOCIAL_STUDIO=true
FEATURE_PII_REDACTOR=true

# ================== Observability ==================
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
