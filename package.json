{
  "name": "kk-os",
  "private": true,
  "version": "0.1.0",
  "description": "Küchen Klaus Operatives Betriebssystem – Monorepo",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.10.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "prisma:generate": "pnpm --filter @kk/api exec prisma generate",
    "prisma:migrate": "pnpm --filter @kk/api exec prisma migrate dev",
    "prisma:seed": "pnpm --filter @kk/api exec tsx prisma/seed.ts",
    "compose:up": "docker compose -f infra/compose/docker-compose.yml --env-file .env up -d",
    "compose:down": "docker compose -f infra/compose/docker-compose.yml down",
    "compose:logs": "docker compose -f infra/compose/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "tsx": "^4.7.0",
    "prettier": "^3.2.5",
    "eslint": "^8.57.0"
  }
}
